<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="48dp">

        <!-- Left: status + QR codes (2/3 width: two 240dp codes side by side) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:paddingEnd="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#D0D7DE"
                android:textSize="20sp" />

            <!-- Telegram login and Stremio pairing QR codes, side by side -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/telegram_group"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="32dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/telegram_qr_caption"
                        android:textColor="#D0D7DE"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/qr"
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/qr_description" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stremio_group"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stremio_qr_caption"
                        android:textColor="#D0D7DE"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/stremio_qr"
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/stremio_qr_description" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/password_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/password_hint"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B949E" />

                <Button
                    android:id="@+id/send_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/send" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right: actions and settings -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/open_stremio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_to_stremio"
                android:visibility="gone" />

            <!-- Manual way to add the addon, next to the Stremio code -->
            <TextView
                android:id="@+id/stremio_manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="#8B949E"
                android:textSize="14sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/api_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/api_id_hint"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#8B949E" />

            <EditText
                android:id="@+id/api_hash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/api_hash_hint"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#8B949E" />

            <Button
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/save" />

            <!-- First-run setup: QR that opens my.telegram.org on the phone -->
            <LinearLayout
                android:id="@+id/setup_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/setup_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_qr_caption"
                    android:textColor="#D0D7DE"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/setup_qr"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/setup_qr_description" />
            </LinearLayout>

            <Button
                android:id="@+id/restart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restart" />

            <Button
                android:id="@+id/logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
