<?xml version="1.0" encoding="utf-8"?>
<!-- TV remote focus must be obvious: the selected button is bright blue with
     a white frame, the others are dim gray. The insets keep stacked buttons
     apart. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetTop="5dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <solid android:color="#1A8AD0" />
                <stroke android:width="3dp" android:color="#FFFFFF" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetTop="5dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <solid android:color="#2AABEE" />
                <stroke android:width="3dp" android:color="#FFFFFF" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="5dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <solid android:color="#22272E" />
                <stroke android:width="1dp" android:color="#3D444D" />
            </shape>
        </inset>
    </item>
</selector>
