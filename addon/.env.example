# Copy to .env and fill in. Never commit .env — it holds your Telegram login.

# --- Telegram (required) ---
# Register your own pair at https://my.telegram.org (API development tools).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated by `npm run login`. Full access to your Telegram account — keep secret.
TELEGRAM_SESSION=

# --- HTTP server ---
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from your LAN.
ADDON_HOST=127.0.0.1
ADDON_PORT=7000
# URL Stremio uses to fetch the manifest/catalogs (tunnel URL if behind one).
PUBLIC_BASE_URL=http://127.0.0.1:7000
# URL put into stream links (defaults to PUBLIC_BASE_URL). Use a LAN/loopback
# address here to keep video traffic off a tunnel. Leave commented to default.
# STREAM_BASE_URL=http://192.168.0.10:7000

# --- TMDB (titles, catalogs) ---
# Needed in practice: the fallback key copied from the Kodi addon returns 401.
# Get a free key at https://www.themoviedb.org/settings/api and uncomment.
# TMDB_API_KEY=your_tmdb_v3_key
# TMDB_IMDB_KEY=
# Language for TMDB catalog titles (search always uses English + Hebrew).
TMDB_LANGUAGE=en

# --- Built-in channel catalogs (0 hides the catalog) ---
TG_KIDS_CHAT_ID=-1001251653717
TG_HEBREW_GROUP=-1001106800100
TG_WORLD_GROUP=-1001000750206

# --- Streaming ---
# Telegram request size in KB (max 1024) and requests in flight per stream.
STREAM_CHUNK_KB=1024
STREAM_PARALLEL=2
CACHE_TTL_SECONDS=900
LOG_LEVEL=info
