{
  "name": "telemedia",
  "private": true,
  "description": "Telemedia: Stremio addon streaming from Telegram (addon/) and the Android TV app that runs it on the TV (tv-app/).",
  "scripts": {
    "addon:install": "npm --prefix addon install",
    "addon:build": "npm --prefix addon run build",
    "addon:start": "npm --prefix addon start",
    "addon:login": "npm --prefix addon run login",
    "addon:test": "npm --prefix addon test",
    "tv:libnode": "node tv-app/scripts/fetch-libnode.mjs",
    "tv:bundle": "node tv-app/scripts/bundle-node.mjs",
    "tv:deploy": "node tv-app/scripts/deploy.mjs",
    "tv:release": "node tv-app/scripts/release.mjs"
  }
}
