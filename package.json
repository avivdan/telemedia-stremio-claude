{
  "name": "telemedia",
  "private": true,
  "description": "Telemedia: Stremio addon streaming from Telegram (addon/), the Android TV app that runs it on the TV (tv-app/), the Android phone app (phone-app/) and the Windows tray app (pc-app/).",
  "scripts": {
    "addon:install": "npm --prefix addon install",
    "addon:build": "npm --prefix addon run build",
    "addon:start": "npm --prefix addon start",
    "addon:login": "npm --prefix addon run login",
    "addon:test": "npm --prefix addon test",
    "tv:libnode": "node tv-app/scripts/fetch-libnode.mjs",
    "tv:bundle": "node tv-app/scripts/bundle-node.mjs",
    "tv:deploy": "node tv-app/scripts/deploy.mjs",
    "tv:release": "node tv-app/scripts/release.mjs",
    "phone:libnode": "npm --prefix phone-app run libnode",
    "phone:test": "npm --prefix phone-app test",
    "phone:deploy": "npm --prefix phone-app run deploy --",
    "phone:release": "npm --prefix phone-app run release --",
    "pc:install": "npm --prefix pc-app install",
    "pc:start": "npm --prefix pc-app start",
    "pc:dist": "npm --prefix pc-app run dist"
  }
}
