<?xml version="1.0" encoding="utf-8"?>
<!-- One connected Stremio account, with its own Remove button right below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/account_box"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- breakStrategy simple: a too-long email wraps only before its "@",
         never inside the domain (the default treats it like a web address). -->
    <TextView
        android:id="@+id/lan_account_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:breakStrategy="simple"
        android:textColor="@color/fg"
        android:textSize="16sp" />

    <Button
        android:id="@+id/lan_account_remove"
        style="@style/Telemedia.Button.Secondary"
        android:layout_marginTop="10dp"
        android:text="@string/lan_remove_main" />

    <!-- Why removing this account didn't work, if it didn't. -->
    <TextView
        android:id="@+id/lan_account_error"
        style="@style/Telemedia.Error" />
</LinearLayout>
